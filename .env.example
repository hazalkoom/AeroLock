# ==========================================
# this is an example of how the real .env looks like
# AeroLock Environment Variables Template
# Copy this to .env and replace with real values
# ==========================================

# 1. PostgreSQL (The Ledger)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://aerolock_user:password123@localhost:5432/aerolock

# 2. Redis (The Cache & The Lock)
REDIS_URL=redis://localhost:6379/0

# 3. Internal gRPC Service URLs
SEARCH_SERVICE_URL=localhost:50051
INVENTORY_SERVICE_URL=localhost:50052

# 4. Gateway Configuration
RATE_LIMIT_PER_MINUTE=100